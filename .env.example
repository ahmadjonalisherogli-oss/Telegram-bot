# ==========================================
# BOT AND ADMIN CONFIGURATION
# ==========================================
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz123456789
ADMIN_IDS=123456789,987654321
ADMIN_CHANNEL_ID=-1001234567890

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restaurant_bot_db
DB_USER=postgres
DB_PASS=postgres_password

# Postgres Async URL (SQLAlchemy / asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/restaurant_bot_db

# ==========================================
# REDIS CONFIGURATION (FSM / Caching)
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==========================================
# WEBHOOK / SERVER SETTINGS (Optional)
# ==========================================
WEBHOOK_HOST=https://yourdomain.com
WEBHOOK_PATH=/webhook/bot
WEBHOOK_URL=https://yourdomain.com/webhook/bot
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8000

# ==========================================
# PAYMENT INTEGRATIONS (Optional for Uzbekistan)
# ==========================================
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=
